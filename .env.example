# ============================================================
# EduTrack — Variables de entorno
# Copia este archivo a .env y rellena los valores
# ============================================================

# --- Aplicación ---
FLASK_APP=run.py
FLASK_ENV=development
FLASK_CONFIG=development
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-larga

# --- Base de datos ---
# Por defecto SQLite (no requiere instalación). Para PostgreSQL, descomenta:
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/edutrack
# Ejemplo Neon (cloud):
# DATABASE_URL=postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/edutrack?sslmode=require

# --- HTTPS (solo aplica en producción) ---
# FORCE_HTTPS=false

# --- Email para reset de contraseña (opcional) ---
# Si NO configuras esto, los emails se imprimen en la consola del servidor.
# Recomendaciones (todas tienen tier gratis):
#   - Brevo:    smtp-relay.brevo.com:587 (300 emails/día)
#   - Resend:   smtp.resend.com:587 (100 emails/día)
#   - Mailtrap: sandbox.smtp.mailtrap.io:2525 (solo pruebas)
#
MAIL_SERVER=smtp-relay.brevo.com
 MAIL_PORT=587
 MAIL_USE_TLS=true
 MAIL_USE_SSL=false
 MAIL_USERNAME=ad5423001@smtp-brevo.com
 MAIL_PASSWORD=SMTP KEY
 MAIL_DEFAULT_SENDER=edutrack.notificaciones@gmail.com
 MAIL_ENABLED=true                                                   
